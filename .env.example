# TrueForge (local Docker compose). The compose file maps the container's 8790 to host 8791.
TRUEFORGE_BASE_URL=http://localhost:8791
# TRUEFORGE_TOKEN=            # only when OIDC login is enabled

# Model registered in TrueForge (Settings -> Models, or GET /api/v1/models)
AGENT_MODEL=test/vm-polaris-openai

# The MCP server (../mcp-s2sep) as seen FROM INSIDE the TrueForge container.
# `localhost` there is the container itself; host.docker.internal is your laptop.
MCP_URL=http://host.docker.internal:8000/mcp
# Defaults to the token in ../mcp-s2sep/.mcp_token when unset.
# MCP_AUTH_TOKEN=
# Defaults to AWS_REGION from ../mcp-s2sep/.env when unset.
# AWS_REGION=ap-southeast-2

# Strict freshness: new TrueForge session per message so earlier tool output can never be reused.
# (Same as `python -m janitor_agent.chat --fresh`.) Default off: one session, and the agent's
# instructions force it to re-query the MCP server for every question.
# FRESH_SESSION_PER_MESSAGE=true

# The agent computes costs by running a script in the local Docker sandbox (../sandbox-mcp, start it with
# sandbox-mcp/scripts/run.sh start). Set false to use only the MCP server's cost numbers.
# USE_SANDBOX=true
# SANDBOX_MCP_URL=http://host.docker.internal:8100/mcp      # as seen from the TrueForge container
# SANDBOX_MCP_TOKEN=                                        # defaults to ../sandbox-mcp/.token
